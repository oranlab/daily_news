---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
interface Props { title?: string; description?: string; article?: { date: string }; noindex?: boolean }
const {
  title = '每日新闻 · 读懂世界的新变化',
  description = '按北京时间整理国际要闻与 AI 动态，保留事件日期与报道来源。每天一份，让重要的变化被看见。',
  article,
  noindex = false,
} = Astro.props;
const pageTitle = title.startsWith('每日新闻 ·') ? title : `${title} · 每日新闻`;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const nav = [
  { label: '首页', href: '/' },
  { label: '国际', href: '/topics/world/' },
  { label: 'AI', href: '/topics/ai/' },
  { label: '归档', href: '/archive/' },
  { label: '关于', href: '/about/' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': article ? 'BlogPosting' : 'WebSite',
  ...(article ? { headline: title, datePublished: `${article.date}T00:00:00+08:00`, author: { '@type': 'Organization', name: '每日新闻' } } : { name: '每日新闻' }),
  description,
  url: canonical,
  inLanguage: 'zh-CN',
};
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f5f0" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="每日新闻 RSS" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="每日新闻" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {article && <meta property="article:published_time" content={`${article.date}T00:00:00+08:00`} />}
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('daily-news-theme'); } catch {}
        document.documentElement.dataset.theme = theme === 'light' || theme === 'dark' ? theme : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <header class="site-header container">
      <a href="/" class="brand" aria-label="每日新闻首页"><span class="brand-symbol" aria-hidden="true">日</span><span>每日新闻<small>THE DAILY BRIEF</small></span></a>
      <nav class="primary-nav" aria-label="主导航">{nav.map((item) => <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}</nav>
      <div class="header-actions">
        <a class="icon-button" href="/archive/#search" aria-label="搜索新闻"><Icon name="search" /></a>
        <button class="icon-button theme-toggle" type="button" aria-label="切换深浅主题" aria-pressed="false"><span class="show-light"><Icon name="moon" /></span><span class="show-dark"><Icon name="sun" /></span></button>
        <a class="rss-button" href="/rss.xml"><Icon name="rss" size={16} /><span>订阅 RSS</span></a>
      </div>
    </header>
    <main id="main" class="container"><slot /></main>
    <footer class="site-footer container">
      <div><a href="/" class="footer-brand">每日新闻<span class="accent">.</span></a><p>信息有出处，阅读有分寸。</p></div>
      <div class="footer-links"><a href="/archive/">往期归档</a><a href="/about/">关于本站</a><a href="/rss.xml">RSS 订阅 ↗</a><span>按北京时间归档 · Built with Astro</span></div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const sync = () => toggle?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
      sync();
      toggle?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('daily-news-theme', theme); } catch {}
        sync();
      });
    </script>
  </body>
</html>
