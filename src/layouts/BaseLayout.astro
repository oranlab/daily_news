---
import '../styles/global.css';
import '../styles/fuwari/variables.styl';
import Icon from '../components/Icon.astro';
import DisplaySettings from '../components/DisplaySettings.astro';
import FuwariSidebar from '../components/FuwariSidebar.astro';
import { siteConfig } from '../config';
interface Props { title?: string; description?: string; article?: { date: string }; noindex?: boolean }
const {
  title = `${siteConfig.title} · ${siteConfig.subtitle}`,
  description = '按北京时间整理国际要闻与 AI 动态，保留事件日期与报道来源。每天一份，让重要的变化被看见。',
  article,
  noindex = false,
} = Astro.props;
const pageTitle = title === `${siteConfig.title} · ${siteConfig.subtitle}` ? title : `${title} · ${siteConfig.title}`;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const nav = [
  { label: '首页', href: '/' },
  { label: '国际', href: '/topics/world/' },
  { label: 'AI', href: '/topics/ai/' },
  { label: '归档', href: '/archive/' },
  { label: '关于', href: '/about/' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': article ? 'BlogPosting' : 'WebSite',
  ...(article ? { headline: title, datePublished: `${article.date}T00:00:00+08:00`, author: { '@type': 'Organization', name: siteConfig.title } } : { name: siteConfig.title }),
  description,
  url: canonical,
  inLanguage: 'zh-CN',
};
---
<!doctype html>
<html lang="zh-CN" style={`--hue: ${siteConfig.themeColor.hue}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1f3f8" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {article && <meta property="article:published_time" content={`${article.date}T00:00:00+08:00`} />}
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <script is:inline define:vars={{ defaultHue: siteConfig.themeColor.hue, fixedHue: siteConfig.themeColor.fixed }}>
      (() => {
        let theme;
        try { theme = localStorage.getItem('daily-news-theme'); } catch {}
        document.documentElement.dataset.theme = theme === 'light' || theme === 'dark' ? theme : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.classList.toggle('dark', document.documentElement.dataset.theme === 'dark');
        let hue = defaultHue;
        try {
          const stored = localStorage.getItem('daily-news-hue');
          if (!fixedHue && stored !== null && Number.isFinite(Number(stored)) && Number(stored) >= 0 && Number(stored) <= 360) hue = Number(stored);
        } catch {}
        document.documentElement.style.setProperty('--hue', String(hue));
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    {siteConfig.banner.enable && <div class="site-banner" aria-hidden="true"><img src={siteConfig.banner.src} style={`object-position: ${siteConfig.banner.position}`} alt="" /></div>}
    <header class="site-header container card-base">
      <a href="/" class="brand" aria-label={`${siteConfig.title}首页`}><span class="brand-symbol" aria-hidden="true">日</span><span>{siteConfig.title}</span></a>
      <nav class="primary-nav" aria-label="主导航">{nav.map((item) => <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}</nav>
      <div class="header-actions">
        <a class="icon-button" href="/archive/#search" aria-label="搜索新闻"><Icon name="search" /></a>
        <DisplaySettings />
        <a class="rss-button" href="/rss.xml"><Icon name="rss" size={16} /><span>订阅 RSS</span></a>
      </div>
    </header>
    <div class:list={['site-grid container', { 'with-banner': siteConfig.banner.enable }]}>
      <aside class="site-sidebar"><FuwariSidebar /></aside>
      <div class="content-column">
        <main id="main" class="onload-animation"><slot /></main>
        <footer class="site-footer">
          <p>信息有出处，阅读有分寸。<span>按北京时间归档 · UTC+8</span></p>
          <p>Powered by <a href="https://astro.build/">Astro</a> &amp; <a href="https://github.com/saicaca/fuwari">Fuwari</a><span><a href="/rss.xml">RSS 订阅</a> · <a href="/about/">关于本站</a></span></p>
        </footer>
      </div>
      {Astro.slots.has('toc') && <aside class="page-toc"><slot name="toc" /></aside>}
    </div>
    <a class="back-to-top btn-regular" href="#main" aria-label="回到顶部">↑</a>
  </body>
</html>
