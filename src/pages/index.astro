---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { getNews } from '../lib/news';
const news = await getNews();
---
<BaseLayout>
  <section class="home-intro card-base">
    <p class="eyebrow">THE DAILY BRIEF</p>
    <h1>国际视野，AI 前沿<span class="accent">。</span></h1>
    <p>每天一份有出处的阅读，记录世界与 AI 的新变化。</p>
    <a class="text-link" href="/archive/">共 {news.length} 份日报 · 按北京时间归档 <Icon name="arrow" size={16} /></a>
  </section>
  <section class="post-list" aria-label="最新与往期日报">
    {news.slice(0, 7).map((entry, index) => <PostCard entry={entry} latest={index === 0} />)}
    {!news.length && <p class="empty-state card-base">第一份日报正在整理中。</p>}
  </section>
  <a class="archive-link btn-regular" href="/archive/">浏览全部归档 <Icon name="arrow" size={18} /></a>
</BaseLayout>
